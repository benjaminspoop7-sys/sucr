{
  "name": "sucr",
  "productName": "Sucr",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Sucr — the download manager that shows you the work",
  "scripts": {
    "build:web": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.renderer.json",
    "dev": "npm run build:web && node scripts/run-dev.mjs",
    "build": "npm run build:web && node scripts/build-app.mjs",
    "start": "node scripts/run-dev.mjs --skip-build",
    "verify": "node scripts/verify-m0.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  }
}
